{#
  classic_cv.md.jinja
  ───────────────────
  Faithfully replicates the Google Docs 2-column header and classic layout.
  PDF-safe using inline table grids and standard typographic sizing.
#}

<!-- Masthead: Left Title & Right Contact Info -->
<table style="width: 100%; border-collapse: collapse; border: none; margin-bottom: 12pt;">
  <tr>
    <td style="vertical-align: top; text-align: left; padding: 0; border: none;">
      <div style="font-size: 16pt; font-weight: 700; color: #000000; line-height: 1.15;">{{ contact.full_name }}</div>
      <div style="font-size: 13pt; font-weight: 700; color: #000000; line-height: 1.2; margin-top: 2pt;">{{ contact.title }}</div>
    </td>
    <td style="vertical-align: top; text-align: right; padding: 0; border: none; font-size: 9.5pt; line-height: 1.25; color: #000000;">
      <div><a href="mailto:{{ contact.email }}" style="color: #000000; text-decoration: none;">{{ contact.email }}</a></div>
      <div>mobile: {{ contact.phone }}</div>
      {% if contact.linkedin %}
      <div><a href="https://{{ contact.linkedin | replace('https://', '') }}" style="color: #000000; text-decoration: none;">{{ contact.linkedin | replace('https://', '') }}</a></div>
      {% endif %}
      {% if contact.github %}
      <div><a href="https://{{ contact.github | replace('https://', '') }}" style="color: #000000; text-decoration: none;">{{ contact.github | replace('https://', '') }}</a></div>
      {% endif %}
    </td>
  </tr>
</table>

<!-- Summary Section -->
<div style="font-size: 10pt; font-weight: 700; text-transform: uppercase; color: #000000; margin-top: 10pt; margin-bottom: 4pt;">
  SUMMARY OF QUALIFICATIONS
</div>
<div style="font-size: 9.2pt; line-height: 1.35; color: #000000; text-align: left; margin-bottom: 10pt;">
  {{ summary }}
</div>

<!-- Skills & Competencies (2-Column Grid) -->
<div style="font-size: 10pt; font-weight: 700; text-transform: uppercase; color: #000000; margin-top: 10pt; margin-bottom: 4pt;">
  SKILLS & COMPETENCIES
</div>

{% set all_skills = [] %}
{% for s in core_skills %}{% set _ = all_skills.append(s) %}{% endfor %}
{% if technical_skills.ai_and_automation %}{% for s in technical_skills.ai_and_automation %}{% set _ = all_skills.append(s) %}{% endfor %}{% endif %}
{% if technical_skills.architecture_cloud %}{% for s in technical_skills.architecture_cloud %}{% set _ = all_skills.append(s) %}{% endfor %}{% endif %}
{% if technical_skills.data_and_languages %}{% for s in technical_skills.data_and_languages %}{% set _ = all_skills.append(s) %}{% endfor %}{% endif %}

{% set half_len = ((all_skills | length) + 1) // 2 %}
{% set col1 = all_skills[:half_len] %}
{% set col2 = all_skills[half_len:] %}

<table style="width: 100%; border-collapse: collapse; border: none; margin-bottom: 10pt;">
  <tr>
    <td style="width: 50%; vertical-align: top; padding: 0 10pt 0 0; border: none;">
      {% for item in col1 %}
      <div style="padding-left: 14px; text-indent: -14px; font-size: 8.8pt; line-height: 1.3; color: #000000; margin-bottom: 2pt;">
        ●&nbsp; {{ item }}
      </div>
      {% endfor %}
    </td>
    <td style="width: 50%; vertical-align: top; padding: 0 0 0 10pt; border: none;">
      {% for item in col2 %}
      <div style="padding-left: 14px; text-indent: -14px; font-size: 8.8pt; line-height: 1.3; color: #000000; margin-bottom: 2pt;">
        ●&nbsp; {{ item }}
      </div>
      {% endfor %}
    </td>
  </tr>
</table>

<!-- Professional Experience -->
<div style="font-size: 10pt; font-weight: 700; text-transform: uppercase; color: #000000; margin-top: 10pt; margin-bottom: 4pt;">
  PROFESSIONAL EXPERIENCE
</div>

{% for job in work_experience %}
<div style="break-inside: avoid; page-break-inside: avoid; margin-bottom: 8pt;">
  <!-- Line 1: Title -->
  <div style="font-size: 9.8pt; font-weight: 700; color: #000000; line-height: 1.2;">
    {{ job.title }}
  </div>
  
  <!-- Line 2: Company / Location & Dates -->
  <table style="width: 100%; border-collapse: collapse; border: none; margin-top: 1pt; margin-bottom: 3pt;">
    <tr>
      <td style="padding: 0; text-align: left; vertical-align: baseline; border: none; font-size: 9.2pt; color: #000000;">
        {{ job.company }}{% if job.location %} — {{ job.location }}{% endif %}
      </td>
      <td style="padding: 0; text-align: right; vertical-align: baseline; white-space: nowrap; font-size: 9.2pt; color: #000000; border: none;">
        {{ job.dates }}
      </td>
    </tr>
  </table>

  <!-- Bullets -->
  {% for bullet in job.bullets %}
  <div style="padding-left: 14px; text-indent: -14px; margin-bottom: 2.5pt; font-size: 8.8pt; line-height: 1.3; text-align: left; color: #000000;">
    ●&nbsp; {{ bullet }}
  </div>
  {% endfor %}
</div>
{% endfor %}

<!-- Education Section -->
<div style="font-size: 10pt; font-weight: 700; text-transform: uppercase; color: #000000; margin-top: 10pt; margin-bottom: 4pt;">
  EDUCATION
</div>

{% for edu in education %}
<div style="margin-top: 4pt; font-size: 9.5pt; font-weight: 700; color: #000000;">
  {{ edu.degree }}
</div>
<div style="font-size: 9pt; color: #000000; margin-top: 1pt;">
  {{ edu.institution }}{% if edu.dates %} &mdash; {{ edu.dates }}{% endif %}
</div>
{% endfor %}